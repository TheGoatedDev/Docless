{
    "name": "docless",
    "version": "1.2.0",
    "private": true,
    "description": "Docless",
    "main": "./out/main/index.js",
    "author": "example.com",
    "homepage": "https://electron-vite.org",
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "build": "pnpm run typecheck && electron-vite build",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "lint": "biome check .",
        "format": "biome check --write .",
        "deps:check": "syncpack lint",
        "deps:pin": "syncpack fix",
        "prepare": "husky",
        "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
        "build:unpack": "pnpm run build && electron-builder --dir",
        "build:win": "pnpm run build && electron-builder --win",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@electron-toolkit/preload": "3.0.2",
        "@electron-toolkit/utils": "4.0.0",
        "@fontsource-variable/ibm-plex-sans": "5.3.0",
        "@fontsource-variable/roboto-slab": "5.3.0",
        "@napi-rs/canvas": "1.0.6",
        "@tabler/icons-react": "3.46.0",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-router": "1.170.29",
        "better-sqlite3": "13.0.3",
        "chokidar": "5.0.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "electron-ollama": "0.1.25",
        "electron-updater": "6.8.9",
        "next-themes": "0.4.6",
        "pdfjs-dist": "6.2.108",
        "pino": "10.3.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "4.18.0",
        "sonner": "2.0.8",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@electron-toolkit/tsconfig": "2.0.0",
        "@tanstack/router-plugin": "1.168.32",
        "@types/better-sqlite3": "9.6.0",
        "@types/node": "22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "5.2.0",
        "electron": "43.4.0",
        "electron-builder": "26.15.3",
        "electron-vite": "5.0.0",
        "husky": "9.1.7",
        "lint-staged": "17.3.0",
        "pino-pretty": "13.1.3",
        "syncpack": "15.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "7.3.6"
    },
    "lint-staged": {
        "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
